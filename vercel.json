{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2",
            "memory": 1024,
            "includeFiles": "public/**"
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/profile2.png", "dest": "/public/profile2.png" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:oMth1c1XkgfdBkbqk/BQJCWTMIG1kXDfZmbBEk33Las=",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": ":memory:",
        "LARAVEL_SERVICES_CACHE": "/tmp/services.php",
        "LARAVEL_PACKAGES_CACHE": "/tmp/packages.php"
    }
}
